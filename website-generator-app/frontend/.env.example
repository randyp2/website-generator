# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev profile sync script (frontend/scripts/sync-profiles-from-supabase.ts)
LOCAL_PG_URL=postgresql://portrn:portrn@localhost:5433/portrn_dev
SYNC_PAGE_SIZE=200
UPSERT_BATCH_SIZE=500
DRY_RUN=false

# Backend
NEXT_PUBLIC_BACKEND_URL=

# For prod
# NEXT_PUBLIC_BACKEND_URL=

# Site
NEXT_PUBLIC_SITE_URL=

# For Dev
# NEXT_PUBLIC_SITE_URL=

# Email
RESEND_API_KEY=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dev only — set to true to skip rate limiting locally
DISABLE_RATE_LIMIT=

# --- OAUTH ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
